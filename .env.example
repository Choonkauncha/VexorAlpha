# Copy this file to .env (local dev) or set these in your host's dashboard
# (Vercel: Project → Settings → Environment Variables).

# --- Database (required) ---------------------------------------------------
# Postgres connection string. On Vercel Postgres / Neon, use the pooled URL.
DATABASE_URL=
# Direct (non-pooled) connection, used by Prisma for migrations/db push.
# On Vercel Postgres this is POSTGRES_URL_NON_POOLING; on Neon it's the same
# string with ?sslmode=require and no "-pooler" host segment.
DATABASE_URL_UNPOOLED=

# --- Model providers (set at least one) -------------------------------------
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the default model per provider
# OPENAI_MODEL=gpt-4o-mini
# GOOGLE_MODEL=gemini-2.0-flash
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: ordered per-provider model fallback lists (defaults: free-tier
# models in src/lib/model-fallbacks.ts), e.g.
# GOOGLE_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# OPENROUTER_MODELS=openrouter/free

# Optional: comma-separated provider fallback order, e.g. "openai,anthropic"
# AI_PROVIDER_FALLBACKS=

# --- Auth (required for multi-tenant sessions) --------------------------
# Random secret used to sign httpOnly session cookies (min 16 chars).
AUTH_SECRET=

